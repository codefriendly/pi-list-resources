{
  "name": "pi-list-resources",
  "version": "0.1.0",
  "description": "Pi extension that adds inspection commands for extensions, skills, and prompt templates.",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "keywords": ["pi-package"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefriendly/pi-list-resources.git"
  },
  "bugs": {
    "url": "https://github.com/codefriendly/pi-list-resources/issues"
  },
  "files": [
    "extensions",
    "docs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
